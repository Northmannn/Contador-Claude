# Copie este arquivo para ".env" e preencha com suas credenciais.
# Pegue Client ID e Secret em: https://developer.spotify.com/dashboard

SPOTIPY_CLIENT_ID=seu_client_id_aqui
SPOTIPY_CLIENT_SECRET=seu_client_secret_aqui

# Precisa ser EXATAMENTE igual ao Redirect URI cadastrado no painel do app.
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Preenchido automaticamente depois de rodar "python main.py login".
# Use este valor como secret no GitHub Action (SPOTIFY_REFRESH_TOKEN).
SPOTIFY_REFRESH_TOKEN=
